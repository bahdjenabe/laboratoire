rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() { return request.auth != null; }
    function hasRole(role) {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    match /patients/{id} {
      allow read: if isAuth();
      allow create, update: if hasRole('admin') || hasRole('technicien');
      allow delete: if hasRole('admin');
    }

    // Compteurs de matricules (ex: patients-2026) incrémentés en transaction
    // lors de la création/attribution d'un numéro patient.
    match /compteurs/{id} {
      allow read: if isAuth();
      allow write: if hasRole('admin') || hasRole('technicien');
    }
    
    // Catalogue des examens et de leurs prix. Lecture pour tout le personnel
    // (sélection à la création d'un examen) ; gestion réservée à l'admin.
    match /catalogue_examens/{id} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    match /examens/{id} {
      allow read: if isAuth();
      allow create: if hasRole('admin') || hasRole('technicien');
      // Admin/technicien : modification libre.
      // Médecin : uniquement le changement de statut (validation), pas le contenu.
      allow update: if hasRole('admin') || hasRole('technicien')
        || (hasRole('medecin')
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['statut', 'updatedAt']));
      allow delete: if hasRole('admin');
    }
    
    match /resultats/{id} {
      // Collection entièrement privée : aucune exposition publique.
      // La consultation patient passe par public_resultats (snapshot figé).
      allow get, list: if isAuth();
      // Saisie : admin ou technicien (le médecin ne saisit pas).
      allow create: if hasRole('admin') || hasRole('technicien');
      allow update: if
        // Validation : médecin/admin, uniquement les champs de validation.
        ((hasRole('admin') || hasRole('medecin'))
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['valideParMedecin', 'valideAt', 'token']))
        // Saisie du contenu : admin/technicien, sans toucher à la validation.
        || ((hasRole('admin') || hasRole('technicien'))
          && !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['valideParMedecin', 'valideAt', 'token']));
      allow delete: if hasRole('admin');
    }

    match /public_resultats/{token} {
      // Consultation publique du rapport validé via lien sécurisé (token).
      // get uniquement : le token (≈192 bits) sert de secret ; pas d'énumération.
      // Écriture : médecin/admin uniquement — publier ou révoquer un rapport
      // relève de la validation médicale, pas de la saisie (technicien).
      allow get: if true;
      allow list: if false;
      allow create, update, delete:
        if hasRole('admin') || hasRole('medecin');
    }

    // Pré-inscriptions patients (formulaire public, sans compte).
    // L'id du document est un token (~192 bits) qui sert de secret pour le
    // suivi public. La création est ouverte au public mais strictement
    // validée ; la confirmation/rejet relèvent du personnel d'accueil.
    match /preinscriptions/{token} {
      // Suivi public par token (get) ; pas d'énumération (list = personnel).
      allow get: if true;
      allow list: if isAuth();
      // Création publique : seulement une demande « en attente », champs
      // d'identité requis, et aucune référence interne injectée.
      allow create: if
        request.resource.data.statut == 'en_attente'
        && request.resource.data.prenom is string
        && request.resource.data.prenom.size() > 0
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() >= 6
        && request.resource.data.sexe in ['M', 'F', 'Autre']
        && !('patientId' in request.resource.data)
        && !('commandeId' in request.resource.data);
      // Confirmer / rejeter : admin ou technicien (accueil).
      allow update, delete: if hasRole('admin') || hasRole('technicien');
    }

    match /paiements/{id} {
      allow read: if isAuth();
      // Encaissement : admin ou technicien (accueil).
      allow create, update: if hasRole('admin') || hasRole('technicien');
      // Suppression d'un paiement : admin uniquement (action sensible).
      allow delete: if hasRole('admin');
    }

    match /users/{uid} {
      allow read: if isAuth();
      // Création / suppression d'un compte : admin uniquement.
      allow create, delete: if hasRole('admin');
      // L'admin modifie le compte des AUTRES librement. Toute modification de
      // son PROPRE compte (admin inclus) interdit de changer le rôle (RG-06,
      // protection contre l'élévation/auto-modification de privilèges).
      allow update: if
        (hasRole('admin') && request.auth.uid != uid)
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
    }
  }
}